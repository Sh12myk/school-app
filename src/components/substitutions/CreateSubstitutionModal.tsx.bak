import { useEffect, useMemo, useState } from "react";
import type { Substitution } from "../../types";
import styles from "./CreateSubstitutionModal.module.css";

type Props = {
  open: boolean;
  onClose: () => void;
  onCreate: (s: Substitution) => void;
};

const CLASS_LETTERS = ["А", "Б", "В", "Г"] as const;
const CLASSES: string[] = Array.from({ length: 11 }, (_, i) => i + 1)
  .flatMap((g) => CLASS_LETTERS.map((l) => `${g}-${l}`));

type Status = Substitution["status"];

export default function CreateSubstitutionModal({ open, onClose, onCreate }: Props) {
  const [classId, setClassId] = useState("");
  const [lessonNumber, setLessonNumber] = useState<number>(1);
  const [status, setStatus] = useState<Status>("replaced");
  const [room, setRoom] = useState("");
  const [toTeacherId, setToTeacherId] = useState("");

  useEffect(() => {
    if (!open) return;
    setClassId("");
    setLessonNumber(1);
    setStatus("replaced");
    setRoom("");
    setToTeacherId("");
  }, [open]);

  if (!open) return null;

  const canSave = useMemo(() => {
    if (!classId) return false;
    if (!Number.isFinite(lessonNumber) || lessonNumber < 1 || lessonNumber > 11) return false;

    if (status === "room_changed") return !!room.trim();
    if (status === "replaced") return !!toTeacherId.trim(); // кімната опційно
    return true; // cancelled
  }, [classId, lessonNumber, status, room, toTeacherId]);

  const helper = useMemo(() => {
    if (status === "cancelled") return "Урок буде позначено як скасований.";
    if (status === "room_changed") return "Потрібно вказати новий кабінет.";
    return "Потрібно вказати, хто заміняє (teacherId).";
  }, [status]);

  const submit = () => {
    if (!canSave) return;

    const s: Substitution = {
      classId,
      lessonNumber,
      status,
      ...(room.trim() ? { room: room.trim() } : {}),
      ...(toTeacherId.trim() ? { toTeacherId: toTeacherId.trim() } : {}),
    };

    onCreate(s);
    onClose();
  };

  return (
    <div className={styles.overlay} role="dialog" aria-modal="true">
      <div className={styles.modal}>
        <div className={styles.head}>
          <div className={styles.title}> Внести заміну</div>
          <button className={styles.close} onClick={onClose}></button>
        </div>

        <div className={styles.body}>
          <div className={styles.row}>
            <div className={styles.field}>
              <label>Клас</label>
              <select className={styles.select} value={classId} onChange={(e) => setClassId(e.target.value)}>
                <option value=""> обрати </option>
                {CLASSES.map((c) => (
                  <option key={c} value={c}>{c}</option>
                ))}
              </select>
            </div>

            <div className={styles.field}>
              <label>Урок №</label>
              <input
                className={styles.input}
                inputMode="numeric"
                value={String(lessonNumber)}
                onChange={(e) => setLessonNumber(Number(e.target.value))}
                placeholder="1..11"
              />
            </div>
          </div>

          <div className={styles.row}>
            <div className={styles.field}>
              <label>Тип заміни</label>
              <select className={styles.select} value={status} onChange={(e) => setStatus(e.target.value as Status)}>
                <option value="replaced"> Заміна вчителя</option>
                <option value="room_changed"> Зміна кабінету</option>
                <option value="cancelled"> Скасовано</option>
              </select>
              <div className={styles.helper}>{helper}</div>
            </div>
          </div>

          {status === "room_changed" && (
            <div className={styles.field}>
              <label>Новий кабінет</label>
              <input className={styles.input} value={room} onChange={(e) => setRoom(e.target.value)} placeholder="Напр.: 310" />
            </div>
          )}

          {status === "replaced" && (
            <div className={styles.row}>
              <div className={styles.field}>
                <label>Хто заміняє (teacherId)</label>
                <input className={styles.input} value={toTeacherId} onChange={(e) => setToTeacherId(e.target.value)} placeholder="Напр.: u1" />
              </div>
              <div className={styles.field}>
                <label>Кабінет (опційно)</label>
                <input className={styles.input} value={room} onChange={(e) => setRoom(e.target.value)} placeholder="Напр.: 214" />
              </div>
            </div>
          )}

          <div className={styles.actions}>
            <button className={styles.btn} onClick={onClose}>Скасувати</button>
            <button
              className={canSave ? `${styles.btn} ${styles.btnPrimary}` : `${styles.btn} ${styles.btnDisabled}`}
              onClick={submit}
              disabled={!canSave}
            >
              Зберегти
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}