import { useEffect, useMemo, useState } from "react";
import type { Substitution } from "../../types";
import styles from "./CreateSubstitutionModal.module.css";

type Props = {
  open: boolean;
  onClose: () => void;
  onCreate: (s: Substitution) => void;
};

const CLASS_LETTERS = ["Рђ", "Р‘", "Р’", "Р“"] as const;
const CLASSES: string[] = Array.from({ length: 11 }, (_, i) => i + 1)
  .flatMap((g) => CLASS_LETTERS.map((l) => `${g}-${l}`));

type Status = Substitution["status"];

export default function CreateSubstitutionModal({ open, onClose, onCreate }: Props) {
  const [classId, setClassId] = useState("");
  const [lessonNumber, setLessonNumber] = useState<number>(1);
  const [status, setStatus] = useState<Status>("replaced");
  const [room, setRoom] = useState("");
  const [toTeacherId, setToTeacherId] = useState("");

  // reset when opening
  useEffect(() => {
    if (!open) return;
    setClassId("");
    setLessonNumber(1);
    setStatus("replaced");
    setRoom("");
    setToTeacherId("");
  }, [open]);

  //  hooks must run ALWAYS
  const canSave = useMemo(() => {
    if (!open) return false;
    if (!classId) return false;
    if (!Number.isFinite(lessonNumber) || lessonNumber < 1 || lessonNumber > 11) return false;

    if (status === "room_changed") return !!room.trim();
    if (status === "replaced") return !!toTeacherId.trim();
    return true; // cancelled
  }, [open, classId, lessonNumber, status, room, toTeacherId]);

  const helper = useMemo(() => {
    if (status === "cancelled") return "РЈСЂРѕРє Р±СѓРґРµ РїРѕР·РЅР°С‡РµРЅРѕ СЏРє СЃРєР°СЃРѕРІР°РЅРёР№.";
    if (status === "room_changed") return "РџРѕС‚СЂС–Р±РЅРѕ РІРєР°Р·Р°С‚Рё РЅРѕРІРёР№ РєР°Р±С–РЅРµС‚.";
    return "РџРѕС‚СЂС–Р±РЅРѕ РІРєР°Р·Р°С‚Рё, С…С‚Рѕ Р·Р°РјС–РЅСЏС” (teacherId).";
  }, [status]);

  const submit = () => {
    if (!canSave) return;

    const s: Substitution = {
      classId,
      lessonNumber,
      status,
      ...(room.trim() ? { room: room.trim() } : {}),
      ...(toTeacherId.trim() ? { toTeacherId: toTeacherId.trim() } : {}),
    };

    onCreate(s);
    onClose();
  };

  // after hooks  safe early return
  if (!open) return null;

  return (
    <div className={styles.overlay} role="dialog" aria-modal="true">
      <div className={styles.modal}>
        <div className={styles.head}>
          <div className={styles.title}> Р’РЅРµСЃС‚Рё Р·Р°РјС–РЅСѓ</div>
          <button className={styles.close} onClick={onClose}>Закрити</button>
        </div>

        <div className={styles.body}>
          <div className={styles.row}>
            <div className={styles.field}>
              <label>РљР»Р°СЃ</label>
              <select className={styles.select} value={classId} onChange={(e) => setClassId(e.target.value)}>
                <option value=""> РѕР±СЂР°С‚Рё </option>
                {CLASSES.map((c) => (
                  <option key={c} value={c}>{c}</option>
                ))}
              </select>
            </div>

            <div className={styles.field}>
              <label>РЈСЂРѕРє в„–</label>
              <input
                className={styles.input}
                inputMode="numeric"
                value={String(lessonNumber)}
                onChange={(e) => setLessonNumber(Number(e.target.value))}
                placeholder="1..11"
              />
            </div>
          </div>

          <div className={styles.row}>
            <div className={styles.field}>
              <label>РўРёРї Р·Р°РјС–РЅРё</label>
              <select className={styles.select} value={status} onChange={(e) => setStatus(e.target.value as Status)}>
                <option value="replaced"> Р—Р°РјС–РЅР° РІС‡РёС‚РµР»СЏ</option>
                <option value="room_changed"> Р—РјС–РЅР° РєР°Р±С–РЅРµС‚Сѓ</option>
                <option value="cancelled"> РЎРєР°СЃРѕРІР°РЅРѕ</option>
              </select>
              <div className={styles.helper}>{helper}</div>
            </div>
          </div>

          {status === "room_changed" && (
            <div className={styles.field}>
              <label>РќРѕРІРёР№ РєР°Р±С–РЅРµС‚</label>
              <input className={styles.input} value={room} onChange={(e) => setRoom(e.target.value)} placeholder="РќР°РїСЂ.: 310" />
            </div>
          )}

          {status === "replaced" && (
            <div className={styles.row}>
              <div className={styles.field}>
                <label>РҐС‚Рѕ Р·Р°РјС–РЅСЏС” (teacherId)</label>
                <input className={styles.input} value={toTeacherId} onChange={(e) => setToTeacherId(e.target.value)} placeholder="РќР°РїСЂ.: u1" />
              </div>
              <div className={styles.field}>
                <label>РљР°Р±С–РЅРµС‚ (РѕРїС†С–Р№РЅРѕ)</label>
                <input className={styles.input} value={room} onChange={(e) => setRoom(e.target.value)} placeholder="РќР°РїСЂ.: 214" />
              </div>
            </div>
          )}

          <div className={styles.actions}>
            <button className={styles.btn} onClick={onClose}>РЎРєР°СЃСѓРІР°С‚Рё</button>
            <button
              className={canSave ? `${styles.btn} ${styles.btnPrimary}` : `${styles.btn} ${styles.btnDisabled}`}
              onClick={submit}
              disabled={!canSave}
            >
              Р—Р±РµСЂРµРіС‚Рё
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}