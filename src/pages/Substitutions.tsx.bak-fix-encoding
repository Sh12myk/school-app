import { useEffect, useMemo, useState } from "react";
import type { Lesson, Substitution } from "../types";
import styles from "./Substitutions.module.css";
import { useCurrentUser } from "../hooks/useCurrentUser";
import CreateSubstitutionModal from "../components/substitutions/CreateSubstitutionModal";

type Filter = "all" | "myLessons" | "myHomeroom" | "class";

const SUBS_KEY = "schoolapp.subs.items.v1";
const LESSONS_KEY = "schoolapp.lessons.items.v1";

// seed (поки без Firebase)
const SUBS_SEED: Substitution[] = [
  { lessonNumber: 1, classId: "7-Б", status: "replaced", toTeacherId: "u5" },
  { lessonNumber: 3, classId: "6-А", status: "room_changed", room: "310" },
  { lessonNumber: 5, classId: "7-Б", status: "replaced", toTeacherId: "u1" },
  { lessonNumber: 6, classId: "9-В", status: "cancelled" },
];

// seed уроків  тимчасово, поки не підключили реальний розклад
const LESSONS_SEED: Lesson[] = [
  { lessonNumber: 1, start: "08:30", end: "09:15", classId: "7-Б", subject: "Українська мова", room: "214", teacherId: "u1" },
  { lessonNumber: 2, start: "09:25", end: "10:10", classId: "7-Б", subject: "Математика", room: "215", teacherId: "u2" },
  { lessonNumber: 3, start: "10:20", end: "11:05", classId: "6-А", subject: "Біологія", room: "214", teacherId: "u1" },
  { lessonNumber: 4, start: "11:15", end: "12:00", classId: "8-В", subject: "Біологія", room: "214", teacherId: "u1" },
  { lessonNumber: 5, start: "12:10", end: "12:55", classId: "7-Б", subject: "Географія", room: "110", teacherId: "u3" },
  { lessonNumber: 6, start: "13:05", end: "13:50", classId: "7-Б", subject: "Історія", room: "302", teacherId: "u4" },
];

const CLASS_LETTERS = ["А", "Б", "В", "Г"] as const;
const CLASSES: string[] = Array.from({ length: 11 }, (_, i) => i + 1)
  .flatMap((g) => CLASS_LETTERS.map((l) => `${g}-${l}`));

function loadJson<T>(key: string, seed: T): T {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return seed;
    return JSON.parse(raw) as T;
  } catch {
    return seed;
  }
}
function saveJson<T>(key: string, value: T) {
  try { localStorage.setItem(key, JSON.stringify(value)); } catch {}
}

function statusLabel(s: Substitution) {
  if (s.status === "cancelled") return " Скасовано";
  if (s.status === "room_changed") return ` Кабінет  ${s.room ?? "?"}`;
  if (s.status === "replaced") return ` Заміна (вчитель  ${s.toTeacherId ?? "?"})${s.room ? `  каб. ${s.room}` : ""}`;
  return String((s as any).status ?? "");
}

export default function Substitutions() {
  const { roles, homeroomClassId, teacherId } = useCurrentUser();

  const [subs, setSubs] = useState<Substitution[]>([]);
  const [lessons, setLessons] = useState<Lesson[]>([]);
  const [filter, setFilter] = useState<Filter>("myLessons");
  const [classId, setClassId] = useState<string>("");
  const [openCreate, setOpenCreate] = useState(false);

  const canUseMyHomeroom = roles.includes("homeroom") && !!homeroomClassId;
  const isAdmin = roles.includes("admin");

  useEffect(() => {
    setSubs(loadJson(SUBS_KEY, SUBS_SEED));
    setLessons(loadJson(LESSONS_KEY, LESSONS_SEED));
  }, []);

  useEffect(() => { saveJson(SUBS_KEY, subs); }, [subs]);
  useEffect(() => { saveJson(LESSONS_KEY, lessons); }, [lessons]);

  // якщо вимкнули роль "homeroom"  не зависаємо на фільтрі
  useEffect(() => {
    if (filter === "myHomeroom" && !canUseMyHomeroom) setFilter("myLessons");
  }, [filter, canUseMyHomeroom]);

  const myLessonKeys = useMemo(() => {
    // ключі уроків, які веде поточний teacherId
    const keys = lessons
      .filter((l) => l.teacherId === teacherId)
      .map((l) => `${l.classId}#${l.lessonNumber}`);
    return new Set(keys);
  }, [lessons, teacherId]);

  const visible = useMemo(() => {
    let arr = [...subs];

    if (filter === "myLessons") {
      arr = arr.filter((s) => myLessonKeys.has(`${s.classId}#${s.lessonNumber}`));
    }

    if (filter === "myHomeroom" && canUseMyHomeroom) {
      arr = arr.filter((s) => s.classId === homeroomClassId);
    }

    if (filter === "class") {
      if (classId) arr = arr.filter((s) => s.classId === classId);
      else arr = [];
    }

    arr.sort((a, b) => a.lessonNumber - b.lessonNumber);
    return arr;
  }, [subs, filter, myLessonKeys, canUseMyHomeroom, homeroomClassId, classId]);

  const total = subs.length;
  const totalMyLessons = subs.filter((s) => myLessonKeys.has(`${s.classId}#${s.lessonNumber}`)).length;
  const totalMyClass = canUseMyHomeroom ? subs.filter((s) => s.classId === homeroomClassId).length : 0;

  const onCreate = (s: Substitution) => {
    setSubs((prev) => [s, ...prev]);
  };

  return (
    <div>
      <div className={styles.header}>
        <div>
          <h1 className={styles.title}>Заміни</h1>
          <div className={styles.sub}>
            Сьогодні: <b>{total}</b>  Мої уроки: <b>{totalMyLessons}</b>
            {canUseMyHomeroom && <>  Мій клас: <b>{totalMyClass}</b> ({homeroomClassId})</>}
          </div>
        </div>

        <div className={styles.actionsTop}>
          {isAdmin && (
            <button className={`${styles.btn} ${styles.btnPrimary}`} onClick={() => setOpenCreate(true)}>
              + Внести заміну
            </button>
          )}
        </div>
      </div>

      <div className={styles.controls}>
        <button
          className={filter === "myLessons" ? `${styles.chip} ${styles.chipActive}` : styles.chip}
          onClick={() => setFilter("myLessons")}
        >
           Мої уроки
        </button>

        {canUseMyHomeroom && (
          <button
            className={filter === "myHomeroom" ? `${styles.chip} ${styles.chipActive}` : styles.chip}
            onClick={() => setFilter("myHomeroom")}
          >
             Мій клас ({homeroomClassId})
          </button>
        )}

        <button
          className={filter === "all" ? `${styles.chip} ${styles.chipActive}` : styles.chip}
          onClick={() => setFilter("all")}
        >
           Всі
        </button>

        <button
          className={filter === "class" ? `${styles.chip} ${styles.chipActive}` : styles.chip}
          onClick={() => setFilter("class")}
        >
           Обрати клас
        </button>
      </div>

      {filter === "class" && (
        <div className={`${styles.row} ${styles.rowSpacing}`}>
          <select className={styles.select} value={classId} onChange={(e) => setClassId(e.target.value)}>
            <option value=""> обрати </option>
            {CLASSES.map((c) => (
              <option key={c} value={c}>{c}</option>
            ))}
          </select>
        </div>
      )}

      <div className={styles.list}>
        {visible.length === 0 ? (
          <div className={styles.empty}>Нічого немає для вибраного фільтра.</div>
        ) : (
          visible.map((s, idx) => (
            <div key={`${s.classId}-${s.lessonNumber}-${s.status}-${idx}`} className={styles.card}>
              <div className={styles.top}>
                <div>
                  <div className={styles.h}>
                    {s.lessonNumber} урок  {s.classId}
                  </div>
                  <div className={styles.meta}>{statusLabel(s)}</div>
                </div>

                <span className={styles.badge}>{s.status}</span>
              </div>
            </div>
          ))
        )}
      </div>

      <CreateSubstitutionModal
        open={openCreate}
        onClose={() => setOpenCreate(false)}
        onCreate={onCreate}
      />
    </div>
  );
}