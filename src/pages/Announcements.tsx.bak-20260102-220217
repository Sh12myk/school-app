import { useEffect, useMemo, useState } from "react";
import type { Announcement } from "../types";
import styles from "./Announcements.module.css";
import CreateAnnouncementModal from "../components/announcements/CreateAnnouncementModal";

const ITEMS_KEY = "schoolapp.announcements.items.v1";
const ACK_KEY = "schoolapp.announcements.acked.v1";
const ROLES_KEY = "schoolapp.user.roles.v1";

// тимчасові mock-оголошення (як seed)
const SEED: Announcement[] = [
  { id: "a1", type: "meeting", title: "Нарада о 14:30", requiresAck: true },
  { id: "a2", type: "survey", title: "Пройти опитування до кінця дня", requiresAck: false },
  { id: "a3", type: "admin", title: "Нагадування: подати журнали до 16:00", requiresAck: true },
  { id: "a4", type: "critical", title: "Тривога: діяти за алгоритмом укриття", requiresAck: false },
];

type Filter = "all" | Announcement["type"];
type ReadFilter = "all" | "unacked" | "acked";

function typeLabel(t: Announcement["type"]) {
  switch (t) {
    case "critical": return "🚨 Терміново";
    case "admin": return "🏫 Адміністрація";
    case "meeting": return "👥 Нарада";
    case "survey": return "📝 Опитування";
    case "info": return "ℹ️ Інфо";
    default: return String(t);
  }
}

function loadRoles(): string[] {
  try {
    const raw = localStorage.getItem(ROLES_KEY);
    if (!raw) return ["teacher"];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : ["teacher"];
  } catch {
    return ["teacher"];
  }
}

function loadItems(): Announcement[] {
  try {
    const raw = localStorage.getItem(ITEMS_KEY);
    if (!raw) return SEED;
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return SEED;
    return parsed as Announcement[];
  } catch {
    return SEED;
  }
}

function saveItems(items: Announcement[]) {
  try { localStorage.setItem(ITEMS_KEY, JSON.stringify(items)); } catch {}
}

function loadAcked(): Set<string> {
  try {
    const raw = localStorage.getItem(ACK_KEY);
    if (!raw) return new Set();
    const arr = JSON.parse(raw);
    if (!Array.isArray(arr)) return new Set();
    return new Set(arr as string[]);
  } catch {
    return new Set();
  }
}

function saveAcked(set: Set<string>) {
  try { localStorage.setItem(ACK_KEY, JSON.stringify(Array.from(set))); } catch {}
}

export default function Announcements() {
  const [items, setItems] = useState<Announcement[]>([]);
  const [typeFilter, setTypeFilter] = useState<Filter>("all");
  const [readFilter, setReadFilter] = useState<ReadFilter>("all");
  const [ackedIds, setAckedIds] = useState<Set<string>>(new Set());
  const [openCreate, setOpenCreate] = useState(false);
  const [roles, setRoles] = useState<string[]>(["teacher"]);

  useEffect(() => {
    setItems(loadItems());
    setAckedIds(loadAcked());
    setRoles(loadRoles());
  }, []);

  useEffect(() => { saveItems(items); }, [items]);
  useEffect(() => { saveAcked(ackedIds); }, [ackedIds]);

  const isAdmin = roles.includes("admin");

  const onAck = (id: string) => {
    setAckedIds((prev) => {
      const next = new Set(prev);
      next.add(id);
      return next;
    });
  };

  const onCreate = (a: Announcement) => {
    setItems((prev) => [a, ...prev]);
  };

  const filtered = useMemo(() => {
    let arr = [...items];

    if (typeFilter !== "all") arr = arr.filter((a) => a.type === typeFilter);

    if (readFilter === "acked") arr = arr.filter((a) => ackedIds.has(a.id));
    if (readFilter === "unacked") arr = arr.filter((a) => !ackedIds.has(a.id));

    arr.sort((a, b) => Number(ackedIds.has(a.id)) - Number(ackedIds.has(b.id)));
    return arr;
  }, [items, typeFilter, readFilter, ackedIds]);

  const total = items.length;
  const unacked = items.filter((a) => !ackedIds.has(a.id)).length;

  return (
    <div>
      <div className={styles.header}>
        <div>
          <h1 className={styles.title}>Оголошення</h1>
          <div className={styles.sub}>
            Всього: <b>{total}</b> · Непрочитані: <b>{unacked}</b>
          </div>
        </div>

        <div className={styles.actionsTop}>
          {isAdmin && (
            <button className={`${styles.btn} ${styles.btnPrimary}`} onClick={() => setOpenCreate(true)}>
              + Створити
            </button>
          )}
        </div>
      </div>

      <div className={styles.controls}>
        {(["all", "critical", "admin", "meeting", "survey", "info"] as Filter[]).map((f) => (
          <button
            key={f}
            className={f === typeFilter ? `${styles.chip} ${styles.chipActive}` : styles.chip}
            onClick={() => setTypeFilter(f)}
          >
            {f === "all" ? "🗂️ Всі" : typeLabel(f)}
          </button>
        ))}
      </div>

      <div className={styles.controls}>
        {(["all", "unacked", "acked"] as ReadFilter[]).map((f) => (
          <button
            key={f}
            className={f === readFilter ? `${styles.chip} ${styles.chipActive}` : styles.chip}
            onClick={() => setReadFilter(f)}
          >
            {f === "all" ? "Усі" : f === "unacked" ? "Непрочитані" : "Прочитані"}
          </button>
        ))}
      </div>

      <div className={styles.list}>
        {filtered.map((a) => {
          const acked = ackedIds.has(a.id);

          return (
            <div key={a.id} className={acked ? `${styles.card} ${styles.dim}` : styles.card}>
              <div className={styles.top}>
                <div>
                  <div className={styles.h}>{a.title}</div>
                  <div className={styles.meta}>{typeLabel(a.type)}</div>
                </div>

                <span className={styles.badge}>
                  {a.requiresAck ? (acked ? "✅ Ознайомлено" : "Потрібно ack") : "Оголошення"}
                </span>
              </div>

              {a.requiresAck && (
                <div className={styles.actions}>
                  {acked ? (
                    <span className={styles.badge}>✅ Ознайомлено</span>
                  ) : (
                    <button className={styles.btn} onClick={() => onAck(a.id)}>
                      Ознайомився
                    </button>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <CreateAnnouncementModal
        open={openCreate}
        onClose={() => setOpenCreate(false)}
        onCreate={onCreate}
      />
    </div>
  );
}