.header{
  margin-bottom: 12px;
}

.title{
  font-size: 34px;
  letter-spacing: -0.03em;
  margin: 6px 0 0;
}

.sub{
  margin-top: 6px;
  color: var(--muted);
  font-size: 13px;
}

.card{
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 14px;
  margin-bottom: 12px;
}

.row{
  display:flex;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
  justify-content:space-between;
}

.label{
  font-weight: 800;
}

.select{
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.92);
  outline: none;
  width: min(240px, 100%);
}

.note{
  margin-top: 10px;
  color: var(--muted);
  font-size: 13px;
}